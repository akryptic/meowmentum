{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "meomentum",
	"version": "0.1.0",
	"identifier": "dev.akryptic.meomentum",
	"build": {
		"frontendDist": "../build",
		"devUrl": "http://localhost:5173",
		"beforeDevCommand": "pnpm dev",
		"beforeBuildCommand": "pnpm build"
	},
	"app": {
		"windows": [
			{
				"url": "/setup",
				"title": "Moementum",
				"label": "setup",
				"width": 240,
				"height": 420,
				"resizable": false,
				"fullscreen": false,
				"center": true,
				"alwaysOnTop": true,
				"decorations": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"android": {
			"debugApplicationIdSuffix": ".debug"
		}
	}
}
